# App
APP_NAME=Product Backlog Internship ICTU
APP_ENV=development
DEBUG=true

# MySQL — host port 3307 (tránh 3306 của MySQL khác trên máy)
DB_HOST=localhost
DB_PORT=3307
DB_NAME=ictu_internship
DB_USER=ictu
DB_PASSWORD=ictu
MYSQL_ROOT_PASSWORD=root

# JWT (authenticate_login.py)
JWT_SECRET_KEY=dev-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Frontend Docker
# nginx (service frontend): http://localhost:3000
FRONTEND_PORT=3000
# Vite (profile dev): http://localhost:5173
FRONTEND_DEV_PORT=5173
