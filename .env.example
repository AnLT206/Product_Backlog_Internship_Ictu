# App
APP_NAME=ICTU Internship
APP_ENV=development
DEBUG=true

# MySQL (khớp docker-compose.yml)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ictu_internship
DB_USER=ictu
DB_PASSWORD=ictu
MYSQL_ROOT_PASSWORD=root

# JWT (authenticate_login.py)
JWT_SECRET_KEY=dev-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Seed admin (chỉ development — python -m scripts.seed_admin)
ADMIN_SEED_EMAIL=admin@ictu.edu.vn
ADMIN_SEED_PASSWORD=Admin@123
ADMIN_SEED_FULL_NAME=System Admin

# Backend API
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# Frontend (Docker)
# nginx build: http://localhost:8080
FRONTEND_PORT=8080
# Vite hot-reload (profile dev): http://localhost:5173
FRONTEND_DEV_PORT=5173
