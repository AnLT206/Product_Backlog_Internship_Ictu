# ============================================================
# frontend/.env.example
# Sao chép file này thành .env rồi điền giá trị thật.
# KHÔNG commit file .env vào git.
# ============================================================

# URL gốc của backend FastAPI (không có dấu / cuối)
VITE_API_URL=http://localhost:8000

# reCAPTCHA v2 Checkbox Site Key
# TODO: Vào https://www.google.com/recaptcha/admin/create → tạo site key v2
#       Chọn "Checkbox" → điền domain → lấy Site Key → điền vào đây.
#       PHẢI cấu hình trước khi deploy production.
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_v2_site_key_here
